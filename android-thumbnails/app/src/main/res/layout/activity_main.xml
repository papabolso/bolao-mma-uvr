<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/barra"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/fundo"
        app:subtitleTextColor="@color/texto_fraco"
        app:title="@string/app_name"
        app:titleTextColor="@color/texto" />

    <ProgressBar
        android:id="@+id/progresso"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:indeterminateTint="@color/ambar"
        android:max="1000"
        android:progressTint="@color/ambar"
        android:visibility="gone" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp"
        android:singleLine="true"
        android:textColor="@color/texto_fraco"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Ver por pasta ou por data, e o dia procurado no calendário -->
    <LinearLayout
        android:id="@+id/linhaVisao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingBottom="4dp"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/grupoVisao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoPasta"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/ver_pasta" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoData"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/ver_data" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.chip.Chip
            android:id="@+id/filtroDia"
            style="@style/Widget.Material3.Chip.Input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:checkable="false"
            android:ellipsize="end"
            android:visibility="gone"
            app:chipIcon="@drawable/ic_calendario"
            app:chipIconVisible="true"
            app:closeIconVisible="true" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grade"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="2dp"
            android:paddingBottom="24dp" />

        <TextView
            android:id="@+id/vazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:textColor="@color/texto_fraco"
            android:textSize="14sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/painelPermissao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/permissao_titulo"
                android:textColor="@color/texto"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingMultiplier="1.15"
                android:text="@string/permissao_texto"
                android:textColor="@color/texto_fraco"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botaoPermissao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/permissao_botao" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
